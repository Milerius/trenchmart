// Local deploy override (NOT committed): repo config + global_fetch_strictly_public so the
// Next /api/v1 rewrite can reach the API Worker on workers.dev in the same account.
// Build with API_URL=https://api.trenchmart.fun exported: next.config.ts bakes the /api/v1
// rewrite target in at build time and defaults to 127.0.0.1:8787 (CF error 1003 in prod).
{
  "name": "trenchmart-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
}
