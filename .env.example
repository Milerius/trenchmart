# ── App ──────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:8787
SIWS_DOMAIN=localhost:3000
SESSION_SECRET=change-me-32-bytes-min
INTERNAL_TOKEN=change-me            # sandbox VPS → api

# ── Database (Supabase Postgres) ─────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# ── Cloudflare ───────────────────────────────────────
CF_ACCOUNT_ID=
R2_BUCKET=trenchmart-files
R2_ACCESS_KEY_ID=                   # for presigned URLs
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_MEDIA_BASE=               # optional public bucket/domain for listing images

# ── Solana ───────────────────────────────────────────
SOLANA_CLUSTER=devnet               # devnet | mainnet-beta

# Public Reown / WalletConnect project id. Create one at https://cloud.reown.com
# (sign in, create a project, copy the Project ID). Allowed origin: https://trenchmart.fun.
# Next inlines this at build time. Empty hides the WalletConnect row; the app links stay.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=9e9aab84f03d9799c7a3dc4ee77fa93b
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_WEBHOOK_SECRET=change-me
VAULT_ADDRESS=                      # Squads vault PDA (escrow)
TRENCH_MINT=                        # pump.fun mint; devnet test mint before launch

# Fee bucket wallets
BUCKET_WALLET_BUYBACK=
BUCKET_WALLET_AI_VERIFICATION=
BUCKET_WALLET_OPS=
BUCKET_WALLET_SAFETY=

# ── AI verification (no human verifiers) ─────────────
# Local agent id. Optional URL of an external model gateway; empty = in-process agent.
AI_AGENT_ID=trenchmart-ai-v1
AI_VERIFIER_URL=
AI_ATTEST_SECRET=change-me

# ── X (Twitter) OAuth ────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8787/api/v1/auth/x/callback

# ── Sandbox runner (Hetzner) ─────────────────────────
# Empty runner URL runs the isolate in the API process. A URL gets one immediate POST /jobs.
# There is no poll interval. Each check is capped between 10s and 20s.
SANDBOX_RUNNER_URL=
SANDBOX_BUDGET_MS=15000
PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# ── Dev overrides ────────────────────────────────────
ESCROW_HOURS_OVERRIDE=              # e.g. 0.033 (2 min) in dev
SOL_USD_OVERRIDE=                   # optional fixed SOL price in USD, skips the cache fetch
LANDING_STATS=auto                  # auto | mock | real. auto uses mock until a live listing exists
