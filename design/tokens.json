{
  "$version": "2.0.0",
  "$notes": "Contrast ratios are WCAG 2.2 against bg #0A0B0A / surface #121412. Text tokens are >= 4.5:1, control boundaries >= 3:1. 'decor' and 'border*' (except border-control) are decorative only.",
  "color": {
    "bg": "#0A0B0A",
    "bg-inset": "#0E100E",
    "surface": "#121412",
    "surface-2": "#161916",
    "border": "#262A26",
    "border-soft": "#1E221E",
    "border-strong": "#343A34",
    "border-control": "#646C63",
    "text": "#EDEFEA",
    "text-2": "#B4BAB2",
    "muted": "#9BA19A",
    "faint": "#868D86",
    "decor": "#6E756D",
    "accent": "#C6F432",
    "accent-hover": "#DDFF7A",
    "on-accent": "#0A0B0A",
    "accent-bg": "#141A08",
    "accent-border": "#2E3A12",
    "accent-label": "#9FAF86",
    "accent-body": "#C9D0BE",
    "warn": "#F5A524",
    "warn-bg": "#1C160A",
    "warn-border": "#3A2C0E",
    "warn-highlight-bg": "#2A1F08",
    "warn-highlight-text": "#F5C46A",
    "danger": "#FF8A7A",
    "danger-bg": "#1F1210",
    "danger-border": "#4A2620",
    "info": "#7CC4FF",
    "info-bg": "#0F1620",
    "info-border": "#1E3448",
    "disabled-bg": "#161916",
    "disabled-text": "#868D86",
    "network-banner": { "bg": "#1C160A", "border": "#3A2C0E", "text": "#F5A524" },
    "category": {
      "userscript": { "text": "#C6F432", "bg": "#141A10" },
      "wallet_list": { "text": "#7CC4FF", "bg": "#0F1620" },
      "filter": { "text": "#F5A524", "bg": "#1C160A" },
      "setup": { "text": "#C9A2FF", "bg": "#18121F" },
      "strategy": { "text": "#6EE7C8", "bg": "#0E1A17" },
      "alerts": { "text": "#FF8A7A", "bg": "#1F1210" }
    },
    "split": { "buyback": "#C6F432", "ai_verification": "#7CC4FF", "ops": "#C9A2FF", "safety": "#F5A524" }
  },
  "status": {
    "$notes": "Every status renders as symbol + WORD + colour. Never colour alone.",
    "version": {
      "uploading": { "symbol": "↑", "label": "UPLOADING", "tone": "neutral" },
      "scanning": { "symbol": "◑", "label": "SCANNING", "tone": "info" },
      "needs_creator": { "symbol": "!", "label": "NEEDS YOUR NOTE", "tone": "warn" },
      "in_review": { "symbol": "◷", "label": "IN AI REVIEW", "tone": "info" },
      "live": { "symbol": "✓", "label": "AI-VERIFIED", "tone": "ok" },
      "rejected": { "symbol": "×", "label": "REJECTED", "tone": "danger" },
      "superseded": { "symbol": "↷", "label": "SUPERSEDED", "tone": "neutral" },
      "delisted": { "symbol": "⊘", "label": "DELISTED", "tone": "danger" }
    },
    "order": {
      "$notes": "Matches packages/shared/src/state.ts ORDER_STATUSES. 'Confirming' is a client tx state, not an order state.",
      "pending": { "symbol": "○", "label": "AWAITING PAYMENT", "tone": "neutral" },
      "paid": { "symbol": "●", "label": "PAID · IN ESCROW", "tone": "ok" },
      "disputed": { "symbol": "!", "label": "DISPUTED", "tone": "danger" },
      "released": { "symbol": "✓", "label": "RELEASED", "tone": "ok" },
      "refunded": { "symbol": "↺", "label": "REFUNDED", "tone": "info" },
      "expired": { "symbol": "⌛", "label": "EXPIRED", "tone": "neutral" }
    },
    "tx": {
      "idle": { "label": "Review", "tone": "neutral" },
      "awaiting_signature": { "symbol": "◔", "label": "Approve in your wallet", "tone": "warn" },
      "confirming": { "symbol": "◑", "label": "Confirming on Solana", "tone": "info" },
      "confirmed": { "symbol": "✓", "label": "Payment confirmed", "tone": "ok" },
      "cancelled": { "symbol": "i", "label": "Cancelled in wallet", "tone": "neutral" },
      "failed": { "symbol": "×", "label": "Payment didn't go through", "tone": "danger" }
    },
    "check": {
      "pass": { "symbol": "✓", "label": "PASS", "tone": "ok" },
      "warn": { "symbol": "!", "label": "WARN", "tone": "warn" },
      "fail": { "symbol": "×", "label": "FAIL", "tone": "danger" },
      "na": { "symbol": "–", "label": "N/A", "tone": "neutral" }
    },
    "tone": {
      "ok": { "fg": "#C6F432", "bg": "#141A08", "border": "#2E3A12" },
      "warn": { "fg": "#F5A524", "bg": "#1C160A", "border": "#3A2C0E" },
      "danger": { "fg": "#FF8A7A", "bg": "#1F1210", "border": "#4A2620" },
      "info": { "fg": "#7CC4FF", "bg": "#0F1620", "border": "#1E3448" },
      "neutral": { "fg": "#B4BAB2", "bg": "#121412", "border": "#262A26" }
    }
  },
  "contrast": {
    "text/bg": 17.03,
    "text-2/surface": 9.35,
    "muted/surface": 7.01,
    "faint/surface": 5.44,
    "faint/surface-2": 5.21,
    "accent/surface": 14.44,
    "on-accent/accent": 15.39,
    "warn/warn-bg": 8.81,
    "danger/surface": 8.08,
    "info/surface": 9.87,
    "border-control/surface": 3.41,
    "border-control/bg": 3.63,
    "decor/surface (decorative only)": 3.9
  },
  "font": {
    "sans": "Geist, system-ui, sans-serif",
    "mono": "'Geist Mono', ui-monospace, monospace",
    "numeric": "tabular-nums"
  },
  "fontSize": {
    "hero": "clamp(40px, 6vw, 68px)",
    "h1": "44px",
    "h1-phone": "30px",
    "h2": "28px",
    "h3": "20px",
    "lead": "18px",
    "body": "15px",
    "meta": "13px",
    "label": "12px",
    "tag": "11px",
    "price-xl": "36px",
    "price": "17px"
  },
  "radius": { "tag": "6px", "control": "10px", "card": "14px", "panel": "16px", "sheet": "20px", "pill": "999px" },
  "space": [4, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32, 48, 64, 72],
  "layout": {
    "maxWidth": "1280px",
    "gutter": "24px",
    "gutterPhone": "16px",
    "breakpoints": { "sm": "640px", "md": "768px", "lg": "960px", "xl": "1280px" },
    "sidebarWrapBelow": "960px",
    "modalWidth": "480px",
    "stickyBuyBarHeight": "76px"
  },
  "control": {
    "height": { "sm": "36px", "md": "44px", "lg": "48px", "xl": "52px" },
    "minTarget": "24px",
    "touchTarget": "44px"
  },
  "focus": { "outline": "2px solid #C6F432", "offset": "2px", "scrollPaddingBottom": "96px" },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "Disable skeleton shimmer, spinners become a static ◑ symbol, no slide-in for sheets"
  },
  "money": {
    "unit": "lamports (bigint)",
    "display": "SOL, exact: trim trailing zeros, keep at least 2 decimals, never round. 1.55625 SOL stays 1.55625 SOL. Don't use shared formatSol() for user-facing amounts: it truncates to 3 decimals.",
    "examples": { "1500000000": "1.50", "1556250000": "1.55625", "75000000": "0.075", "5000": "0.000005" }
  },
  "fees": {
    "$notes": "Display copy only. Source of truth is packages/shared/config.ts (fee_bps, tier_rebate_bps, fee_split_bps).",
    "marketplaceFee": "5% of list price, paid by the buyer",
    "creatorCommission": "0%",
    "tierDiscountOfFee": { "none": "0%", "scout": "25%", "trencher": "60%", "og": "100%" },
    "splitOfNetFee": { "buyback": "40%", "ai_verification": "25%", "ops": "20%", "safety": "15%" }
  }
}
